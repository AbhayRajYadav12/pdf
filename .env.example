NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=4000
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/pdf_summary
REDIS_URL=redis://127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=document_chunks
STORAGE_DIR=./data/documents
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=gemini
GENERATION_PROVIDER=gemini
RERANKER_PROVIDER=none
RERANKER_URL=http://127.0.0.1:8088
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INGESTION_MODE=queue
RATE_LIMIT_STORE=redis
TRUST_PROXY=false
LOG_LEVEL=info
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=200
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
OCR_MIN_CHARS=40
RETRIEVAL_DENSE_K=20
RETRIEVAL_SPARSE_K=20
RERANK_CANDIDATES=20
CONTEXT_TOKEN_BUDGET=4000
GENERATION_MAX_OUTPUT_TOKENS=1024
RELEVANCE_MIN_SCORE=0.35
INGESTION_CONCURRENCY=2
JOB_TIMEOUT_MS=600000
METRICS_TOKEN=
