{
  "name": "pdf-summary-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pdf-summary/api --filter @pdf-summary/worker --filter @pdf-summary/web dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/api --filter ./apps/worker --filter ./apps/web build",
    "typecheck": "pnpm -r --filter ./packages/* --filter ./apps/api --filter ./apps/worker --filter ./apps/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "eval": "tsx packages/evaluation/src/cli.ts",
    "perf": "tsx tests/performance/retrieval.bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
